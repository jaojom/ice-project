{
  "name": "containerized-business-analytics",
  "version": "1.0.0",
  "description": "Backend API for Project Monitoring",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand tests/integration",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:db:start": "docker-compose -f docker-compose.test.yml up -d postgres-test",
    "test:db:stop": "docker-compose -f docker-compose.test.yml down",
    "test:db:migrate": "cross-env NODE_ENV=test ts-node tests/setup/runMigrations.ts",
    "test:ci": "npm run test:db:start && sleep 3 && npm run test:db:migrate && npm run test && npm run test:db:stop"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
